# Mutants that no test can kill, because the change cannot alter what the
# code does. Each entry names the file, the source line as written, the
# mutation, and why. sextant mutate fails on an entry that matches nothing,
# so an entry goes away together with the code it describes.

allow {
    file = "tools/sextant/internal/meri/parse.go"
    line = "case c >= 0x20 && c < 0x7F:"
    mutation = ">= to >"
    reason = "this is a fast path for plain ASCII; a space it no longer takes goes through the general path below, which accepts it the same way"
}

allow {
    file = "tools/sextant/internal/meri/parse.go"
    line = "escaped := false"
    mutation = "false to true"
    reason = "the flag only decides whether the result is built from a copy; with or without the copy the string is the same"
}

allow {
    file = "lib/x86/src/raw.rs"
    line = "pub fn enable_no_execute() -> bool {"
    mutation = "body to { true }"
    reason = "every firmware the tests run on, OVMF included, turns no-execute pages on before any loader runs, and turning them off to try again would fault on the page tables already using bit 63; the loader's x86.no_execute and the kernel's kernel.no_execute checks still see it on"
}

allow {
    file = "kernel/src/raw/interrupts.rs"
    line = "if INSTALLED.swap(true, Ordering::AcqRel) {"
    mutation = "true to false"
    reason = "the flag keeps a second call from writing the tables while the processor uses them; the kernel calls install once, and a second call would write the same values again, so no check can see the difference"
}

allow {
    file = "kernel/src/raw/mod.rs"
    line = "if PANICKING.swap(true, Ordering::AcqRel) {"
    mutation = "true to false"
    reason = "the flag stops a panic that comes while the panic screen is drawn; the tests cannot cause one there without changing that code, and the planned crashes reset the flag on purpose before each"
}

allow {
    file = "lib/uefi/src/raw/file.rs"
    line = "fn drop(&mut self) {"
    mutation = "body to {}"
    reason = "closing only hands the firmware's handle back; no call the firmware offers tells whether a handle is still open, and the loader opens few files before boot services end and take every handle with them"
}

allow {
    file = "lib/uefi/src/raw/image.rs"
    line = "false,"
    mutation = "false to true"
    reason = "LoadImage's boot policy only changes what happens for a path that names a device without a file; the loader always names a file, and the firmware loads it the same either way"
}

allow {
    file = "lib/uefi/src/raw/image.rs"
    line = "self.started = true;"
    mutation = "true to false"
    reason = "an application that was started and came back is unloaded by the firmware itself, so the unload a forgotten flag would add finds no image and changes nothing the tests can see"
}

allow {
    file = "lib/font/src/raster.rs"
    line = "let (dir, top, bottom) = if p0.y < p1.y {"
    mutation = "< to <="
    reason = "the two only differ for a level edge, which covers no rows and returns before its direction is used"
}

allow {
    file = "lib/font/src/raster.rs"
    line = "sum += cell;"
    mutation = "+= to -="
    reason = "coverage is the size of the running sum whichever its sign, since outlines may wind either way, so summing the cells negated gives the same bytes"
}

allow {
    file = "lib/x86/src/raw.rs"
    line = "while tsc() - begin < cycles {"
    mutation = "< to <="
    reason = "the loop ends one counter cycle later at most, which nothing that waits a hundredth or a tenth of a second can tell"
}

allow {
    file = "lib/x86/src/raw.rs"
    line = "pub fn mask_legacy_pics() {"
    mutation = "body to {}"
    reason = "OVMF masks both 8259s before it starts a loader, so on the test machines masking them again changes nothing; on firmware that leaves lines open it keeps their interrupts off the vectors the exceptions use"
}

allow {
    file = "lib/x86/src/raw.rs"
    line = "if tsc() - begin >= cycles {"
    mutation = ">= to >"
    reason = "waiting gives up one counter cycle later at most, which nothing that waits a tenth of a second can tell"
}

allow {
    file = "kernel/src/raw/smp.rs"
    line = "let _ = x86::raw::wait_for(tsc_hz / 10, || RUNNING.load(Ordering::Acquire) > before);"
    mutation = "/ to *"
    reason = "the limit only matters for a core that never starts; every core of the test machines starts, and the wait ends as soon as it has"
}

allow {
    file = "kernel/src/raw/smp.rs"
    line = "let _ = x86::raw::wait_for(tsc_hz / 10, || RUNNING.load(Ordering::Acquire) > before);"
    mutation = "> to >="
    reason = "every core of the test machines has come in by the end of the 0.2 ms after its first startup, so the wait finds it there either way; on slower hardware it keeps the next core's stack from being set while this one still reads its own"
}

allow {
    file = "kernel/src/raw/smp.rs"
    line = ".filter(|&(index, &id)| wait(index + 1, tsc_hz / 100) == Some(u64::from(id)))"
    mutation = "/ to *"
    reason = "the limit only matters for a core that never answers; every core of the test machines answers within microseconds, and the wait ends as soon as it has"
}

allow {
    file = "lib/program/src/raw.rs"
    line = "while self.taken.swap(true, Ordering::Acquire) {"
    mutation = "true to false"
    reason = "a program has one thread, so nothing else ever holds the heap's lock while it allocates; once programs get threads of their own, a check of two of them allocating at once takes this entry's place"
}
