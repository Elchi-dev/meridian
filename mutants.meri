# Mutants that no test can kill, because the change cannot alter what the
# code does. Each entry names the file, the source line as written, the
# mutation, and why. sextant mutate fails on an entry that matches nothing,
# so an entry goes away together with the code it describes.

allow {
    file = "tools/sextant/internal/meri/parse.go"
    line = "case c >= 0x20 && c < 0x7F:"
    mutation = ">= to >"
    reason = "this is a fast path for plain ASCII; a space it no longer takes goes through the general path below, which accepts it the same way"
}

allow {
    file = "tools/sextant/internal/meri/parse.go"
    line = "escaped := false"
    mutation = "false to true"
    reason = "the flag only decides whether the result is built from a copy; with or without the copy the string is the same"
}

allow {
    file = "lib/x86/src/raw.rs"
    line = "pub fn enable_no_execute() -> bool {"
    mutation = "body to { true }"
    reason = "every firmware the tests run on, OVMF included, turns no-execute pages on before any loader runs, and turning them off to try again would fault on the page tables already using bit 63; the loader's x86.no_execute and the kernel's kernel.no_execute checks still see it on"
}

allow {
    file = "kernel/src/raw/interrupts.rs"
    line = "if INSTALLED.swap(true, Ordering::AcqRel) {"
    mutation = "true to false"
    reason = "the flag keeps a second call from writing the tables while the processor uses them; the kernel calls install once, and a second call would write the same values again, so no check can see the difference"
}

allow {
    file = "kernel/src/raw/mod.rs"
    line = "if PANICKING.swap(true, Ordering::AcqRel) {"
    mutation = "true to false"
    reason = "the flag stops a panic that comes while the panic screen is drawn; the tests cannot cause one there without changing that code, and the planned crashes reset the flag on purpose before each"
}

allow {
    file = "lib/uefi/src/raw/file.rs"
    line = "fn drop(&mut self) {"
    mutation = "body to {}"
    reason = "closing only hands the firmware's handle back; no call the firmware offers tells whether a handle is still open, and the loader opens few files before boot services end and take every handle with them"
}

allow {
    file = "lib/uefi/src/raw/image.rs"
    line = "false,"
    mutation = "false to true"
    reason = "LoadImage's boot policy only changes what happens for a path that names a device without a file; the loader always names a file, and the firmware loads it the same either way"
}

allow {
    file = "lib/uefi/src/raw/image.rs"
    line = "self.started = true;"
    mutation = "true to false"
    reason = "an application that was started and came back is unloaded by the firmware itself, so the unload a forgotten flag would add finds no image and changes nothing the tests can see"
}

allow {
    file = "lib/font/src/raster.rs"
    line = "let (dir, top, bottom) = if p0.y < p1.y {"
    mutation = "< to <="
    reason = "the two only differ for a level edge, which covers no rows and returns before its direction is used"
}

allow {
    file = "lib/font/src/raster.rs"
    line = "sum += cell;"
    mutation = "+= to -="
    reason = "coverage is the size of the running sum whichever its sign, since outlines may wind either way, so summing the cells negated gives the same bytes"
}

allow {
    file = "lib/x86/src/raw.rs"
    line = "while tsc() - begin < cycles {"
    mutation = "< to <="
    reason = "the loop ends one counter cycle later at most, which nothing that waits a hundredth or a tenth of a second can tell"
}

allow {
    file = "lib/x86/src/raw.rs"
    line = "pub fn mask_legacy_pics() {"
    mutation = "body to {}"
    reason = "OVMF masks both 8259s before it starts a loader, so on the test machines masking them again changes nothing; on firmware that leaves lines open it keeps their interrupts off the vectors the exceptions use"
}

allow {
    file = "lib/x86/src/raw.rs"
    line = "if tsc() - begin >= cycles {"
    mutation = ">= to >"
    reason = "waiting gives up one counter cycle later at most, which nothing that waits a tenth of a second can tell"
}

allow {
    file = "kernel/src/raw/smp.rs"
    line = "let came = x86::raw::wait_for(tsc_hz, || RUNNING.load(Ordering::Acquire) > before);"
    mutation = "> to >="
    reason = "every core of the test machines has come in by the end of the 0.2 ms after its first startup, so the wait finds it there either way; on slower hardware it keeps the next core's stack from being set while this one still reads its own"
}

allow {
    file = "lib/program/src/raw.rs"
    line = "while self.taken.swap(true, Ordering::Acquire) {"
    mutation = "true to false"
    reason = "a program has one thread, so nothing else ever holds the heap's lock while it allocates; once programs get threads of their own, a check of two of them allocating at once takes this entry's place"
}

allow {
    file = "lib/program/examples/exitwith.rs"
    line = "deeper(depth + 1) + frame[7]"
    mutation = "+ to -"
    reason = "deeper calls itself until the stack runs out, so the sum after the call is never taken"
}

allow {
    file = "kernel/src/raw/ahci.rs"
    line = "set_register(hba::CONTROL, register(hba::CONTROL) | hba::AHCI_ENABLE);"
    mutation = "| to &"
    reason = "QEMU's controller speaks only AHCI and keeps AE set whatever is written to it, so no write can turn AHCI off there"
}

allow {
    file = "kernel/src/raw/ahci.rs"
    line = "let command = register(base + port::COMMAND);"
    mutation = "+ to -"
    reason = "reading the wrong register makes the write below clear every other bit of PxCMD as well; QEMU keeps none of them besides the ones that start and stop the port, so the port comes back as it was, which kernel.ahci.restart compares"
}

allow {
    file = "kernel/src/raw/ahci.rs"
    line = "register(base + port::COMMAND) | port::RECEIVE,"
    mutation = "+ to -"
    reason = "as for reading PxCMD before stopping the port: only the bit set here is one QEMU keeps"
}

allow {
    file = "kernel/src/raw/ahci.rs"
    line = "let idle = wait(|| register(base + port::COMMAND) & (port::RUNNING | port::RECEIVING) == 0);"
    mutation = "+ to -"
    reason = "QEMU stops a port's engines the moment ST and FRE are cleared, so the wait for them ends at once whatever it looks at"
}

allow {
    file = "kernel/src/raw/ahci.rs"
    line = "let idle = wait(|| register(base + port::COMMAND) & (port::RUNNING | port::RECEIVING) == 0);"
    mutation = "| to &"
    reason = "as above: QEMU's engines are stopped by the time the wait first looks"
}

allow {
    file = "kernel/src/raw/ahci.rs"
    line = "return false;"
    mutation = "false to true"
    reason = "this is the port that does not stop in time, which QEMU never has, as above"
}

allow {
    file = "kernel/src/raw/ahci.rs"
    line = "set_address(base + port::COMMAND_LIST, frame + COMMAND_LIST);"
    mutation = "+ to -"
    reason = "both offsets are 0: the command list starts the port's registers and the drive's frame alike"
}

allow {
    file = "kernel/src/raw/ahci.rs"
    line = "set_register(base + port::ERRORS, u32::MAX);"
    mutation = "+ to -"
    reason = "QEMU never sets a bit of PxSERR, so leaving it alone changes nothing there, and the register written instead lies in reserved space"
}

allow {
    file = "kernel/src/raw/ahci.rs"
    line = "let ready = wait(|| register(base + port::TASK_FILE) & (port::BUSY | port::DATA_REQUEST) == 0);"
    mutation = "+ to -"
    reason = "QEMU's disk is never busy and never asks for data while its port starts, so the wait ends at once whatever it looks at"
}

allow {
    file = "kernel/src/raw/ahci.rs"
    line = "let ready = wait(|| register(base + port::TASK_FILE) & (port::BUSY | port::DATA_REQUEST) == 0);"
    mutation = "| to &"
    reason = "as above: QEMU's disk is idle by the time the wait first looks"
}

allow {
    file = "kernel/src/raw/ahci.rs"
    line = "let whole = len > 0 && len.is_multiple_of(size) && len <= MOST;"
    mutation = "> to >="
    reason = "issue refuses a transfer of no bytes before it builds a command, as prdt has no entries for them, so reading or writing nothing still fails as out of range"
}

allow {
    file = "kernel/src/raw/pci.rs"
    line = "if function == 0 && !h.multifunction {"
    mutation = "== to !="
    reason = "the walk then goes on past function 0 of a device with only that one; on q35 the other functions of such a device read as nobody there, so it finds the same functions"
}

allow {
    file = "kernel/src/raw/nvme.rs"
    line = "if !wait(|| state() != State::Off) || state() != State::Ready {"
    mutation = "|| to &&"
    reason = "QEMU's controller never fails as it comes up, so a controller that answered in time is always ready there"
}

allow {
    file = "kernel/src/raw/ps2.rs"
    line = ".any(|_| status() & status::OUTPUT_FULL != 0)"
    mutation = "& to |"
    reason = "QEMU's controller has its answer waiting by the time the status is first read, so taking it at once takes the same byte"
}

allow {
    file = "kernel/src/raw/ps2.rs"
    line = "if status() & status::OUTPUT_FULL != 0 {"
    mutation = "& to |"
    reason = "OVMF leaves nothing waiting in the controller, and with nothing to take, reading the data port changes nothing"
}

allow {
    file = "kernel/src/raw/ps2.rs"
    line = "if status() & status::OUTPUT_FULL != 0 {"
    mutation = "!= to =="
    reason = "as above: with nothing waiting, taking or leaving it is the same"
}

allow {
    file = "kernel/src/raw/ps2.rs"
    line = "if status() & status::OUTPUT_FULL == 0 {"
    mutation = "& to |"
    reason = "the keyboard's interrupt only comes once a byte waits, so the look before taking it always finds one"
}

allow {
    file = "kernel/src/raw/virtio.rs"
    line = "write32(base + common::DEVICE_FEATURE_SELECT, select);"
    mutation = "+ to -"
    reason = "the device feature select register lies at offset 0 of the common configuration, so adding its offset or taking it away is the same"
}

allow {
    file = "kernel/src/raw/tlb.rs"
    line = "if PENDING.load(Ordering::Acquire) & bit == 0 {"
    mutation = "& to |"
    reason = "only cores a shootdown asks get its interrupt; a core that serves one anyway while it waits to start its own only forgets pages of that address space once more and clears a bit that was clear, which changes nothing it reads"
}
